// Prisma schema for Mini CRM / Billing System

generator client {
  provider = "prisma-client"
  output   = "../app/_prisma"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------------------------------

enum Language {
  EN
  RU
}

enum UserRole {
  ADMIN
  MANAGER
}

enum AppointmentStatus {
  PLANNED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  UNPAID
  PAID
  PARTIALLY_PAID
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  OTHER
}

enum ReminderType {
  APPOINTMENT
  PAYMENT
  DEBT
}

enum ReminderStatus {
  PENDING
  SENT
  CANCELLED
}

// ----------------------------------------------------------------------------

model User {
  id       String   @id @default(uuid())
  name     String
  email    String   @unique
  password String
  role     UserRole @default(MANAGER)
  language Language @default(EN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clients      Client[]
  services     Service[]
  appointments Appointment[]
  payments     Payment[]
  reminders    Reminder[]
  auditLogs    AuditLog[]
}

model Client {
  id        String   @id @default(uuid())
  managerId String
  firstName String
  lastName  String
  phone     String?
  email     String?
  notes     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  manager      User          @relation(fields: [managerId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  payments     Payment[]
  reminders    Reminder[]

  @@index([managerId])
  @@index([lastName, firstName])
}

model Service {
  id              String   @id @default(uuid())
  managerId       String
  title           String
  description     String
  price           Decimal  @db.Decimal(10, 2)
  durationMinutes Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  manager      User          @relation(fields: [managerId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([managerId])
}

model Appointment {
  id              String            @id @default(uuid())
  managerId       String
  clientId        String
  serviceId       String
  startAt         DateTime
  durationMinutes Int
  status          AppointmentStatus @default(PLANNED)
  price           Decimal           @db.Decimal(10, 2)
  paymentStatus   PaymentStatus     @default(UNPAID)
  notes           String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  manager  User    @relation(fields: [managerId], references: [id], onDelete: Cascade)
  client   Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service  Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  payments Payment[]
  reminders Reminder[]

  @@index([managerId, startAt])
  @@index([clientId])
}

model Payment {
  id            String        @id @default(uuid())
  managerId     String
  clientId      String
  appointmentId String?
  amount        Decimal       @db.Decimal(10, 2)
  method        PaymentMethod
  paymentDate   DateTime
  notes         String

  createdAt DateTime @default(now())

  manager     User         @relation(fields: [managerId], references: [id], onDelete: Cascade)
  client      Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([managerId, paymentDate])
  @@index([clientId])
}

model Reminder {
  id            String         @id @default(uuid())
  managerId     String
  clientId      String
  appointmentId String?
  type          ReminderType
  remindAt      DateTime
  status        ReminderStatus @default(PENDING)
  message       String

  createdAt DateTime @default(now())

  manager     User         @relation(fields: [managerId], references: [id], onDelete: Cascade)
  client      Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([managerId, remindAt])
  @@index([clientId])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  action     String
  entityType String
  entityId   String?
  description String
  ipAddress  String

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
